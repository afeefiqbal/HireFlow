{
  "name": "ai-job-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Private personal AI-powered job-search and matching dashboard for Afeef Iqbal",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev -w @ai-job-agent/api\" \"npm run dev -w @ai-job-agent/web\"",
    "dev:api": "npm run dev -w @ai-job-agent/api",
    "dev:web": "npm run dev -w @ai-job-agent/web",
    "start:api": "node apps/api/dist/server.js",
    "start:web": "npm run start -w @ai-job-agent/web",
    "build": "npm run build -w @ai-job-agent/shared && npm run build -w @ai-job-agent/api && npm run build -w @ai-job-agent/web",
    "db:generate": "npx prisma generate --schema=./database/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=./database/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=./database/prisma/schema.prisma",
    "db:seed": "npx ts-node ./database/prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=./database/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "dotenv": "^16.6.1",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@prisma/client": "^6.19.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/client@7.10.0": true
  }
}
